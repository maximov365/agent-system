#!/usr/bin/env python3
"""
Post-commit hook: preview downstream updates when framework files change.

Checks the most recent commit for framework file changes. If any are found,
previews `sync.py --all --render --dry-run`. Apply updates explicitly after review.

Install:
    python hooks/install.py
"""

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SYNC_SCRIPT = ROOT / "sync.py"
DOWNSTREAM_REGISTRY = ROOT / "downstream.projects"

sys.path.insert(0, str(ROOT))
from framework_manifest import framework_change_paths, is_framework_change



def get_committed_files() -> set[str]:
    result = subprocess.run(
        ["git", "diff-tree", "--root", "--no-commit-id", "--name-only", "-r", "HEAD"],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    return set(result.stdout.strip().splitlines())


def collect_framework_paths() -> set[str]:
    return framework_change_paths(ROOT)


def has_downstream_projects() -> bool:
    if not DOWNSTREAM_REGISTRY.exists():
        return False
    for line in DOWNSTREAM_REGISTRY.read_text().splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("#"):
            return True
    return False


def main() -> int:
    if not has_downstream_projects():
        return 0

    committed = get_committed_files()
    changed = {name for name in committed if is_framework_change(name)}

    if not changed:
        return 0

    venv_python = ROOT / ".venv" / "bin" / "python3"
    python = str(venv_python) if venv_python.exists() else sys.executable

    print(f"\n  Framework files changed ({len(changed)}). Previewing downstream updates...")

    result = subprocess.run(
        [python, str(SYNC_SCRIPT), "--all", "--render", "--dry-run"],
        cwd=str(ROOT),
    )
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
